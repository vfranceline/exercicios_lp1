#include <stdio.h>
#include<stdbool.h>

int main()
{
    int arr1[5] = {1,1,3,4,5}; 
    int arr2[5] = {1,3,7,4,5}; 
    int temNosDois = 0;
    bool jaExiste = false; 
 

    for(int x=0; x<5; x++){ 
        
        if (x>0){

            for(int i=0; i<x; i++){ 
		        if(arr1[x] == arr1[i]){ 
			        jaExiste = true; 
                    break; 
                } 
            } 
        }
        

        if(jaExiste){ 
		    jaExiste = false; 
		    continue; 
        } 

 

        for(int j=0; j<5; j++){ 

	        if(arr1[x] == arr2[j]){ 
                temNosDois++;	 
                break; 
            }	 
        }

    } 
    
    printf("%d", temNosDois);

    return 0;
}